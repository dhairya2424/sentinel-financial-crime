# Copy to backend/.env (never commit it). Every variable the API reads (docs/06 §4); defaults shown.
# dev | demo | staging | production. Anything but dev requires JWT_SECRET; production requires >=32 characters.
ENV=dev

# Local processes use localhost; docker compose overrides these two to reach the postgres/redis services.
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0

# Required outside dev: >=32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))".
# Never commit a real value. Rotating it signs every user out (docs/11 INC-7).
JWT_SECRET=
JWT_ACCESS_MIN=30
JWT_REFRESH_HOURS=12

TENANT_DEFAULT=tenant_demo
# Written into a tenant's config when the seed first creates it; rules-table versions override both afterwards.
REPORTING_THRESHOLD=50000
CYCLE_MIN_AMOUNT=500000

# WARNING (docs/08 §3, ADR-012/013): app.seed.users creates *@demo.dev logins with the public password Demo!23456.
# The seeds refuse to run with ENV=production. For any real deployment, create users through POST /v1/users with
# unique passwords, remove or disable the demo logins, and set a real JWT_SECRET.
