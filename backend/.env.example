ENV=dev
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379/0
# Required outside dev: >=32 random chars. Never commit a real value.
JWT_SECRET=
JWT_ACCESS_MIN=30
TENANT_DEFAULT=tenant_demo
REPORTING_THRESHOLD=50000
CYCLE_MIN_AMOUNT=500000
PIPELINE_CONCURRENCY=2
# ADR-013: seeded *@demo.dev / Demo!23456 users are dev/demo only (seed refuses ENV=production).
# With ENV=production you MUST rotate or remove them and set a real JWT_SECRET.
