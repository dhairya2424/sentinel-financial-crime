# Copy to frontend/.env for `npm run dev`. Both are baked in at build time.
# The API origin. Leave empty ("") for same-origin, as in the docker image, where nginx proxies /v1 and /v1/ws.
VITE_API_URL=http://localhost:8000
# The WebSocket origin. Leave unset or empty to derive it from VITE_API_URL (http -> ws) or from the page itself.
VITE_WS_URL=ws://localhost:8000
